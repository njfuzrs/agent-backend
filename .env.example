# 复制为 backend/.env 后填写。不要把填过值的文件提交进 git。
# AUTH_PASSWORD / UPLOAD_TOKEN 无默认值，缺了进程会 SystemExit。

# ---- 数据面（必填）----
AUTH_USERNAME=admin
AUTH_PASSWORD=
UPLOAD_TOKEN=

# 管理台 cookie 签名。留空则从 AUTH_PASSWORD 派生。
# SESSION_SECRET=
# 上了 TLS 之后必须 true。本地 http://localhost 保持 false。
# SESSION_COOKIE_SECURE=false

# ---- 服务 ----
# HOST=127.0.0.1
# PORT=8900
# CORS_ORIGINS=["http://localhost:5173"]

# ---- 日志 ----
# 不设文件路径、轮转、采样率：前两个交给 journald，采样现在没有必要。
# LOG_LEVEL 默认 info。生产不要设 debug——debug 只在复现单个问题时临时开，用完调回。
# LOG_FORMAT 默认随数据库：sqlite → text，其余 → json。显式设置优先。
# LOG_LEVEL=info
# LOG_FORMAT=text
# AGENT_VERSION 不写在这里。它由 release.sh / rollback.sh 写到 $ROOT/.version，
# unit 用单独的 EnvironmentFile 加载。写进 .env 会和回滚打架。

# ---- 数据库（默认 SQLite；生产用 PostgreSQL）----
# DATABASE_URL=sqlite+aiosqlite:///./data/trajectories.db
# DATABASE_URL=postgresql+asyncpg://user:pass@127.0.0.1:5432/trajdb

# ---- 存储（默认本地文件；生产可切 OSS）----
# STORAGE_BACKEND=local
#
# ⚠️ TRAJ_FILES_DIR / SESSIONS_DIR 只在 STORAGE_BACKEND=local 下生效。
#    切到 oss 后这两个键就是死键：代码里所有引用都在 `settings.is_oss` 之后，
#    OSS 模式下走不到。切 oss 时请把它们从 .env 删掉，不要留着「以后可能用得上」——
#    指向不存在目录的残留值既不报错也不生效，只会让人误以为轨迹还在本地磁盘。
# TRAJ_FILES_DIR=./data/traj_files
# SESSIONS_DIR=./data/sessions
#
# 切到 oss 时：STORAGE_BACKEND=oss，填下面四项，并删掉上面两项。
# OSS_ACCESS_KEY_ID=
# OSS_ACCESS_KEY_SECRET=
# OSS_ENDPOINT=
# OSS_BUCKET_NAME=
# OSS 读缓存（可选，默认 /tmp/traj-cache，1024MB LRU）
# OSS_CACHE_DIR=/tmp/traj-cache
# OSS_CACHE_MAX_SIZE_MB=1024

# ---- 控制面（M1 身份）----
# CTL_ENROLL_ENABLED=false
# CTL_CREDENTIAL_TTL_DAYS=90
# CTL_ENROLL_CODE_TTL_HOURS=24

# ---- 控制面（M6 遥控中继）----
# 签发响应里的 ws_url 用这个值，不从请求的 Host 猜。
# 生产必须是 wss，且路径落在 nginx 单独的 Upgrade location 上。
# STORAGE_BACKEND=local 且留空时，用 ws://127.0.0.1:8901/api/v1/bridge/ws，只够本机。
# STORAGE_BACKEND=oss（生产）留空则签发 500，不把回环地址发给远程客户端。
# 配了非 wss 又不是回环的地址，签发同样 500，不发错地址。
# BRIDGE_WS_PUBLIC_URL=wss://www.sid-code.cc/traj/api/v1/bridge/ws


# ---- 控制面（M3 策略）----
# policy 无新密钥。下发 GET /api/v1/ctl/policy 走已有设备凭据（Bearer）。
# 未配置策略时有凭据返回 204，客户端 fail-open 到本地 managed-settings。
